# Cloudflare Pages · cabeceras

# Estáticos con hash de contenido en el nombre → caché larga e inmutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML y todo lo demás
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google.com https://*.google.es https://*.googleadservices.com https://*.doubleclick.net https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://analytics.labbo.studio https://www.googletagmanager.com https://*.googleadservices.com https://*.google.com https://static.cloudflareinsights.com; font-src 'self'; connect-src 'self' https://analytics.labbo.studio wss://analytics.labbo.studio https://www.googletagmanager.com https://*.google.com https://*.google.es https://*.googleadservices.com https://*.doubleclick.net https://pagead2.googlesyndication.com https://cloudflareinsights.com; frame-src https://www.googletagmanager.com https://td.doubleclick.net; worker-src 'self' blob:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
