{
  // Worker con assets estáticos (modelo actual de Cloudflare).
  // El build de Git ejecuta `wrangler deploy`, que lee este fichero:
  //   · sube worker.js como Worker
  //   · publica ./public como assets estáticos (con su _headers)
  // Las peticiones a un asset se sirven directas; solo /api/waitlist
  // (que no es un fichero) llega al Worker.
  "name": "landing",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // ── Waitlist por email (Cloudflare Email Routing, sin base de datos) ──
  // El binding send_email deja que el Worker envíe correo. destination_address
  // lo restringe a una única dirección, que debe estar VERIFICADA en
  // Email Routing (Cloudflare › positiva.studio › Email › Destination addresses).
  "send_email": [
    { "name": "SEB", "destination_address": "hola@positiva.studio" }
  ],

  // NOTIFY_TO  → a dónde llega el aviso (misma dirección verificada de arriba).
  // NOTIFY_FROM → remitente; una dirección de un dominio tuyo con Email Routing
  //               (no necesita recibir correo, solo existir como remitente).
  "vars": {
    "NOTIFY_TO": "hola@positiva.studio",
    "NOTIFY_FROM": "waitlist@positiva.studio"
  }
}
