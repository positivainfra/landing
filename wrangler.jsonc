{
  // Worker con assets estáticos (modelo actual de Cloudflare).
  // El build de Git ejecuta `wrangler deploy`, que lee este fichero:
  //   · sube worker.js como Worker
  //   · publica ./public como assets estáticos (con su _headers)
  // Las peticiones a un asset se sirven directas; solo /api/waitlist
  // (que no es un fichero) llega al Worker.
  "name": "landing",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Dominio público del Worker: RUTA DE ZONA, no Custom Domain (desde
  // feat/modo-partido-prep). Un Custom Domain crea un registro DNS de tipo
  // «Worker» que no se puede poner en DNS only, y el «modo partido» de la app
  // (SHOWCASEBRAIN/MODO-PARTIDO.md) necesita hacerlo cuando LaLiga bloquea las
  // IPs de la zona. El registro del apex es ahora un AAAA 100:: con proxy,
  // creado a mano; wrangler NO lo crea ni lo borra.
  //
  // Esta ruta es además la que impide que el comodín `*/*` del frontend de
  // la app (positiva-frontend-production) se coma la landing: antes existía
  // con «Worker: None» y el MISMO patrón, así que el reparto del apex con las
  // rutas `*/media/g/*`, `*/api/track`, etc. de la app no cambia: solo cambia
  // a quién entrega esta ruta. No la borres (ver MODO-PARTIDO.md §1.2).
  "routes": [
    { "pattern": "positiva.studio/*", "zone_name": "positiva.studio" }
  ],

  // ── Waitlist por email (Cloudflare Email Routing, sin base de datos) ──
  // ⚠️ destination_address y NOTIFY_TO deben ser una DESTINATION ADDRESS
  // VERIFICADA (Cloudflare › positiva.studio › Email › Destination addresses).
  // OJO: hola@positiva.studio es una dirección de ENRUTAMIENTO (recibe/reenvía),
  // NO un destino — send_email la rechaza (502). Usa aquí el buzón REAL al que
  // hola@ reenvía (p. ej. tu Gmail/Outlook verificado). El aviso caerá igual
  // donde ya te llega el correo de hola@.
  "send_email": [
    { "name": "SEB", "destination_address": "hola@positiva.studio" }
  ],

  // NOTIFY_TO  → mismo destino verificado de arriba.
  // NOTIFY_FROM → remitente; dirección de un dominio tuyo con Email Routing
  //               (no necesita recibir correo, solo existir como remitente).
  "vars": {
    "NOTIFY_TO": "hola@positiva.studio",
    "NOTIFY_FROM": "waitlist@positiva.studio"
  }
}
